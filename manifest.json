{
  "manifest_version": 3,
  "name": "OnedriveTranscript",
  "version": "2.0",
  "description": "Extrae y resume transcripciones de vídeos en OneDrive y SharePoint mediante IA.",
  "permissions": [
    "activeTab",
    "storage",
    "downloads"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.sharepoint.com/*_layouts/15/stream.aspx*",
        "https://*.sharepoint.com/*_layouts/15/embed.aspx*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OnedriveTranscript",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
